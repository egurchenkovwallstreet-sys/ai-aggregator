{
  "name": "ai-aggregator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "npm run lint && npm run format:check",
    "db:migrate": "node scripts/db-migrate.mjs",
    "voice:up": "docker compose -f services/voice/docker-compose.yml up -d --build",
    "voice:down": "docker compose -f services/voice/docker-compose.yml down",
    "voice:logs": "docker compose -f services/voice/docker-compose.yml logs -f --tail=100",
    "voice:install": "powershell -ExecutionPolicy Bypass -File scripts/voice-install.ps1",
    "voice:dev": "powershell -ExecutionPolicy Bypass -File scripts/voice-install.ps1 -Start",
    "prepare": "husky"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
