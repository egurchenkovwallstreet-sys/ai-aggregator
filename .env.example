# =============================================================================
# AI-агрегатор — шаблон переменных окружения
# Скопируйте в .env.local и заполните значения. Секреты не коммитить.
# =============================================================================

# --- Приложение ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PostgreSQL (+ pgvector) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_aggregator

# --- S3-совместимое хранилище (MinIO / Selectel Object Storage) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=ai-aggregator-media
# Публичный базовый URL для отдачи файлов (CDN или bucket URL)
S3_PUBLIC_URL=

# --- AI-шлюз: provod.ai (основной, OpenAI-compatible) ---
PROVOD_AI_API_KEY=
PROVOD_AI_BASE_URL=https://api.provod.ai/v1

# --- AI-шлюз: Selectel ИИ-роутер (резерв) ---
SELECTEL_AI_API_KEY=
SELECTEL_AI_BASE_URL=

# --- LLM для AI-агента (модель через provod.ai) ---
AGENT_MODEL=

# --- Аутентификация ---
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=
# Magic link: срок жизни ссылки в секундах
AUTH_MAGIC_LINK_TTL_SEC=900

# --- Email (magic link) ---
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Telegram OAuth / Login Widget ---
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- ЮKassa (основные платежи) ---
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
# Секрет для проверки webhook (если используется отдельный)
YUKASSA_WEBHOOK_SECRET=

# --- Robokassa (резервные платежи) ---
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=1

# --- Голос: STT/TTS (Voicy / OpenOcto / voice-gateway, локально) ---
# Установка: services/voice/README.md, npm run voice:up
VOICE_PROVIDER=voicy
VOICE_GATEWAY_URL=http://localhost:8080
VOICE_STT_URL=http://localhost:8080/stt
VOICE_TTS_URL=http://localhost:8080/tts

# --- KodikShield (маскирование ПД перед отправкой в LLM) ---
KODIKSHIELD_API_URL=
KODIKSHIELD_API_KEY=

# --- Rate limiting / очереди (опционально, этап 9) ---
REDIS_URL=

# --- Продуктовые настройки ---
# Бесплатные генерации для нового пользователя (SPEC: 3)
FREE_GENERATIONS_DEFAULT=3
